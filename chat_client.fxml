<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml"
            fx:controller="your.package.ChatClientController" prefWidth="500" prefHeight="400">

    <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
        <!-- Chat Display Area -->
        <TextArea fx:id="chatArea" editable="false" wrapText="true" prefHeight="330" />

        <!-- Message Input and Send Button -->
        <HBox spacing="10">
            <TextField fx:id="messageField" HBox.hgrow="ALWAYS" promptText="Enter your message..." />
            <Button fx:id="sendButton" text="Send" onAction="#sendMessage" />
        </HBox>
    </VBox>

</AnchorPane>
