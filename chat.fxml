<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:controller="ChatClientController" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      spacing="10.0" alignment="CENTER" style="-fx-padding: 10;">
    
    <TextArea fx:id="chatArea" prefHeight="300.0" prefWidth="400.0" editable="false" wrapText="true"/>
    
    <HBox spacing="10.0">
        <TextField fx:id="messageField" HBox.hgrow="ALWAYS"/>
        <Button fx:id="sendButton" text="Send"/>
    </HBox>
</VBox>
